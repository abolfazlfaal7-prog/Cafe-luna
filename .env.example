# Copy this file to .env and fill in your own Supabase project values.
# Never commit .env or put real keys in this file.

# Public (browser) values, from Supabase: Project Settings > API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Edge functions (supabase/functions/admin and supabase/functions/memories) need these.
# Supabase injects them automatically when functions are deployed, so do not add them
# to .env or to the frontend:
# SUPABASE_URL
# SUPABASE_ANON_KEY
# SUPABASE_SERVICE_ROLE_KEY
# SUPABASE_DB_URL
